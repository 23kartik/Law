# Required — Google Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional — unlocks the broader-coverage Indian Kanoon adapter (free tier, signup
# at https://api.indiankanoon.org/signup/). Without this, the platform still works
# using the zero-setup kanoon.dev pilot API (no key needed).
INDIAN_KANOON_API_KEY=
